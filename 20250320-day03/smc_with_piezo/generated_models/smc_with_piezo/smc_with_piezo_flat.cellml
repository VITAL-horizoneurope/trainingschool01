  <component name="piezo_channel_module">
    <variable name="t" units="millis" interface="public"/>
    <variable name="Vm" units="milliV" interface="public"/>
    <variable name="g" units="nS" interface="public"/>
    <variable name="m_V" units="dimensionless" initial_value="m_V_init" interface="public"/>
    <variable name="m_V_init" units="dimensionless" interface="public"/>
    <variable name="m_V_inf" units="dimensionless" interface="public"/>
    <variable name="tau_V" units="millis" interface="public"/>
    <variable name="V_50" units="milliV" interface="public"/>
    <variable name="I_piezo" units="nSmV" interface="public"/>
    <variable name="E_Na" units="milliV" interface="public"/>
    <variable name="k_V" units="milliV" interface="public"/>
    <variable name="m_r" units="dimensionless" initial_value="m_r_init" interface="public"/>
    <variable name="m_r_init" units="dimensionless" interface="public"/>
    <variable name="m_r_inf" units="dimensionless" interface="public"/>
    <variable name="tau_r" units="millis" interface="public"/>
    <variable name="k_r" units="dimensionless" interface="public"/>
    <variable name="r_50" units="dimensionless" interface="public"/>
    <variable name="r_ratio" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>I_piezo</ci>
        <apply>
          <times/>
          <ci>g</ci>
          <ci>m_V</ci>
          <ci>m_r</ci>
          <apply>
            <minus/>
            <ci>Vm</ci>
            <ci>E_Na</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>m_V</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>m_V_inf</ci>
            <ci>m_V</ci>
          </apply>
          <ci>tau_V</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>m_V_inf</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <apply>
                    <minus/>
                    <ci>Vm</ci>
                    <ci>V_50</ci>
                  </apply>
                </apply>
                <ci>k_V</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <!--!!!!! Below here include the equations for stretch sensitive gating.-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>m_r</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>m_r_inf</ci>
            <ci>m_r</ci>
          </apply>
          <ci>tau_r</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>m_r_inf</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <apply>
                    <minus/>
                    <ci>r_ratio</ci>
                    <ci>r_50</ci>
                  </apply>
                </apply>
                <ci>k_r</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
