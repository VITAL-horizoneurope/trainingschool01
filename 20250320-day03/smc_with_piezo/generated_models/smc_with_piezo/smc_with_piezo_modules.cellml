            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>I_total</ci>
                    </apply>
                    <ci>C_m</ci>
                </apply>
            </apply>
        </math>
        <!--!!!!! Here is where to add the piezo current for charge conservation-->
