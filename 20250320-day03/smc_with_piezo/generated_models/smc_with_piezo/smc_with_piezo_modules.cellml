        <variable name="I_total" public_interface="out" units="picoA"/>
        <!--!!!!! Here is where to add the piezo current for charge conservation-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>I_total</ci>
                <apply>
                    <plus/>
                    <ci>I_CaV</ci>
                    <ci>I_leak_all</ci>
                    <ci>I_PMCA</ci>
                    <ci>I_NCX</ci>
                    <ci>I_NaK</ci>
