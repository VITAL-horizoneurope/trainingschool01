<!--&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;vessel mappings&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;//-->
<connection>
   <map_components component_1="smc_module" component_2="piezo_channel_module"/>
   <map_variables variable_1="V" variable_2="Vm"/>
</connection>
<connection>
   <map_components component_1="smc_module" component_2="piezo_channel_module"/>
   <map_variables variable_1="E_Na" variable_2="E_Na"/>
</connection>
<connection>
   <map_components component_1="smc_module" component_2="piezo_channel_module"/>
   <map_variables variable_1="I_piezo" variable_2="I_piezo"/>
</connection>
